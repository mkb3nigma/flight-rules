#!/usr/bin/env bash
# post-merge hook — cleanup reminder after merging into the integration branch.
#   1. Flags worktrees whose branch is now merged (stale — remove them)
#      and what still runs from each: processes, Compose containers (#109)
#   2. Lists merged branches safe to delete
#   3. Writes a note file, and prints it when it has something to do (no flight-rules
#      hook reads the file — a user's own may: #110)
#
# Adapt the parameters below, commit into the repo, install via install.sh.

# Parameters from .ai/flight-rules.conf when it has them (the working tree is fine
# here — this hook reports, it gates nothing), else the values below.
# read_conf <key> <file>: pre-commit-check.sh's, verbatim — quotes, trailing comments —
# so a key reads here as the guard and doctor read it (session-start.test.sh compares).
# Its own sed kept single quotes: PROTECTED_BRANCHES='^(main|dev)$', ✅ to doctor,
# matched no branch and put `git branch -d main` under "safe to delete" (full release
# review, S1).
read_conf() {
  local key="$1" file="$2"
  [ -r "$file" ] || return 1
  sed -n -E "s/^[[:space:]]*${key}[[:space:]]*=[[:space:]]*(.*)$/\1/p" "$file" \
    | sed -E 's/[[:space:]]+#.*$//; s/[[:space:]]+$//; s/^"(.*)"$/\1/; s/^'\''(.*)'\''$/\1/' \
    | tail -1
}
_conf() { read_conf "$1" "$(git rev-parse --show-toplevel)/.ai/flight-rules.conf"; }
INTEGRATION_BRANCH=$(_conf INTEGRATION_BRANCH)
INTEGRATION_BRANCH="${INTEGRATION_BRANCH:-main}"  # project parameter: {INTEGRATION_BRANCH}
# {PROTECTED_BRANCHES}: which branches must never be offered for deletion. This used
# to be the literal list `main|staging`, which meant a project calling its branches
# anything else — trunk, qa, release-2 — had them listed as "safe to delete" in the
# note offered as commands to run, with no layer objecting. The names a
# project uses are its own; the conf is where they are declared. The environment first
# and `none` as `off`, as the guard and session-start read it: the guard refused a
# deletion this note offered.
PROTECTED_RE="${FLIGHT_RULES_PROTECTED_BRANCHES:-$(_conf PROTECTED_BRANCHES)}"
PROTECTED_RE="${PROTECTED_RE:-^(main|master|dev|develop|development|staging|stage|qa|uat|prod|production)$|^release(/|$)}"
case "$PROTECTED_RE" in off|none) PROTECTED_RE='^$' ;; esac
NOTE_PATH='.claude/post-merge-note.md'  # where the note is written (and printed; no
                                        # flight-rules hook reads the file: #110)

# shq <s>: <s> quoted for a shell to paste, bare when it is plain, else in '…' with each
# ' written '\''. Not printf %q: macOS bash 3.2's splits a multibyte character and
# leaves a raw byte, so `fix/ü-ß` printed as invalid UTF-8 (fix review, 2026-10-24).
# Nor sed: BSD sed stops on bytes that are not UTF-8 and printed '' (fourth review).
# Leading = and ~ are quoted too: zsh expands both. The letters are spelled out: a
# range like A-Z follows the locale's collation. Kept verbatim in step across
# post-merge, install.sh, flight-rules-doctor.sh, session-start.sh, the agent guard
# and the ref gate (tested).
shq() {
  local q="'\\''"
  case "$1" in
    ''|=*|'~'*|*[!ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789._/@+,:-]*) printf "'%s'" "${1//\'/$q}" ;;
    *) printf '%s' "$1" ;;
  esac
}

CURRENT_BRANCH=$(git branch --show-current 2>/dev/null)
[[ "$CURRENT_BRANCH" != "$INTEGRATION_BRANCH" ]] && exit 0

REPO_ROOT=$(git rev-parse --show-toplevel)
NOTE_FILE="$REPO_ROOT/$NOTE_PATH"

# A feature merge is only a topic branch actually merged IN: a merge commit whose
# second parent is NOT main's tip. Skip fast-forwards (no merge commit) and
# back-merges of main into the integration branch (routine reconcile/maintenance) —
# those print nothing.
_merged_in=$(git rev-parse -q --verify 'HEAD^2' 2>/dev/null || echo "")
is_feature_merge() {
  [[ -z "$_merged_in" ]] && return 1            # fast-forward / not a merge commit
  local ref ref_sha name
  for ref in main origin/main; do
    ref_sha=$(git rev-parse -q --verify "$ref" 2>/dev/null) || continue
    [[ "$_merged_in" == "$ref_sha" ]] && return 1   # merged-in commit IS main's tip → back-merge
  done
  # …or the tip of any other protected branch, local or origin's: a project whose
  # released branch is not called main back-merges it too (mission review G2,
  # 2026-10-29). Case-insensitively, as every layer matches the pattern. Only the refs
  # at the merged commit: a grep per ref in the repo took seconds a merge with
  # thousands of remote branches (0.28.0 release review).
  while read -r ref; do
    name=${ref#refs/heads/}; name=${name#refs/remotes/origin/}
    [[ "$name" == "$INTEGRATION_BRANCH" ]] && continue
    printf '%s' "$name" | grep -qiE -e "$PROTECTED_RE" 2>/dev/null && return 1
  done < <(git for-each-ref --points-at "$_merged_in" --format='%(refname)' refs/heads refs/remotes/origin 2>/dev/null)
  # A pull of this branch's own upstream that had to merge is no feature either, and
  # prints nothing (fix review, 2026-10-29).
  ref_sha=$(git rev-parse -q --verify '@{upstream}' 2>/dev/null) && [[ "$_merged_in" == "$ref_sha" ]] && return 1
  return 0
}

# Parse merged branch from merge commit message
MERGE_MSG=$(git log -1 --pretty=%s HEAD 2>/dev/null)
# sed, not `grep -P`: macOS ships BSD grep without -P, and the first version fell
# through to "unknown" on every merge there. Handles the four subject shapes git
# and GitHub write: "Merge branch 'x'", "Merge branch 'x' into y", "Merge
# remote-tracking branch 'origin/x' into y" (what a local merge from origin/<branch>
# writes — the owner flow since 2026-09-15, recorded as `unknown` until #63; the
# remote prefix is dropped because the LOCAL branch is what `git branch -d` wants),
# "Merge pull request #N from owner/x", then the generic "Merge x into y".
MERGED_BRANCH=$(printf '%s\n' "$MERGE_MSG" | sed -nE \
  -e "s/^Merge branch '([^']+)'.*/\\1/p" \
  -e "s|^Merge remote-tracking branch '[^/']+/([^']+)'.*|\\1|p" \
  -e 's|^Merge pull request #[0-9]+ from [^/]+/(.*)$|\1|p' \
  -e 's/^Merge ([^ ]+) into .*/\1/p' | head -1)
# A subject none of those shapes fits — `git merge -m "…" fix/x`, a merge by sha — names
# no branch, and the merge's own worktree was then counted among earlier merges' (0.28.0
# release review): the local branch at the merged commit names it instead.
[[ -z "$MERGED_BRANCH" && -n "$_merged_in" ]] && MERGED_BRANCH=$(git for-each-ref --points-at "$_merged_in" \
  --format='%(refname:lstrip=2)' refs/heads 2>/dev/null | grep -vxF "$INTEGRATION_BRANCH" | head -1)
[[ -z "$MERGED_BRANCH" ]] && MERGED_BRANCH="unknown"

# All branches already merged into the integration branch.
# for-each-ref, not `git branch --merged`: that decorates its output — `*` for the
# current branch, `+` for one checked out in another worktree — and only `*` was
# stripped, so a branch held by a worktree reached the note as `git branch -d + fix/x`
# (error: branch '+' not found). Following this repo's own worktree-per-change workflow
# was enough to produce it. for-each-ref emits bare names: no marker to remember.
# The current branch is the integration branch here — the hook exits above otherwise.
# `lstrip=2`, not `short`: `short` abbreviates against ALL refs, so a tag sharing a
# branch's name makes it come back as `heads/<name>` — which passes both filters below
# and put `git branch -d heads/main` in the note. `refs/heads/` on --merged for the same
# reason: a bare name there resolves to the tag. (Found by review, 2026-09-12.)
# -i: protected is matched case-insensitively, as every other layer matches it (#103
# review).
ALL_MERGED=$(git for-each-ref --merged "refs/heads/$INTEGRATION_BRANCH" --format='%(refname:lstrip=2)' refs/heads 2>/dev/null \
  | grep -v '^$' \
  | grep -vxF "$INTEGRATION_BRANCH" \
  | grep -viE -e "$PROTECTED_RE")

JUST_MERGED="$MERGED_BRANCH"
# -x: a substring match drops `fix/ab` from the list whenever `fix/a` was the branch
# just merged, and the note is the only place that branch gets mentioned.
PREVIOUSLY_MERGED=$(echo "$ALL_MERGED" | grep -vxF "$JUST_MERGED" || true)
# `git branch -d` judges a branch that has an upstream against that upstream, not HEAD:
# one cut with `-b fix/x origin/<integration>` is refused until the merge is pushed
# (2026-10-04, three of four branches refused). The note is written the moment the merge
# lands, before the owner pushes, so a branch -d would refuse right now says which
# upstream has to receive it first. No upstream, or one that has it: nothing is added.
# The full ref, not %(upstream:short): short is a local branch's bare name and turns
# ambiguous next to a tag, and neither is under refs/remotes/. An upstream that no
# longer resolves (pruned, deleted on the remote) makes git fall back to HEAD, so -d
# works and nothing is said.
refused_until() {
  local up
  up=$(git for-each-ref --format='%(upstream)' "refs/heads/$1" 2>/dev/null)
  [[ -n "$up" ]] || return 0
  git rev-parse -q --verify "$up^{commit}" >/dev/null 2>&1 || return 0
  git merge-base --is-ancestor "refs/heads/$1" "$up" 2>/dev/null && return 0
  case "$up" in
    refs/remotes/*) printf 'refused until %s has it — push that first' "$(shq "${up#refs/remotes/}")" ;;
    *)              printf 'refused until %s contains it' "$(shq "${up#refs/heads/}")" ;;
  esac
}

# Worktrees whose branch is in the merged list
STALE_WORKTREES=()
while IFS= read -r line; do
  wt_path=$(echo "$line" | awk '/^worktree /{print substr($0,10)}')
  [[ -z "$wt_path" || "$wt_path" == "$REPO_ROOT" ]] && continue
  [[ ! -d "$wt_path" ]] && continue
  wt_branch=$(git -C "$wt_path" branch --show-current 2>/dev/null || echo "")
  # A detached-HEAD worktree has no branch, and `grep -qF ""` matches every line —
  # it was reported as stale and offered for removal with work still in it.
  [[ -z "$wt_branch" ]] && continue
  if echo "$ALL_MERGED" | grep -qxF "$wt_branch" 2>/dev/null; then
    STALE_WORKTREES+=("$wt_path")
  fi
done < <(git worktree list --porcelain 2>/dev/null)

# What still runs from a worktree about to be removed: a server, database or watcher a
# check started there outlives the branch, and once the directory is gone it runs on
# from nowhere (AppliHawk, 2026-10-24: dev servers up for days, #109). Processes whose
# working directory is inside the worktree, or whose command line names it; Docker
# Compose containers whose project directory is inside it, stopped ones too — what
# they leave is disk space (owner, 2026-10-24: many old containers). Listed, never
# stopped: a shell the owner has open there is no leftover, and the reader of the note
# cannot tell a check's server from someone's editor.
#
# Read once per merge, here in the hook's own shell — a cache filled inside $(…) is
# thrown away with the subshell, and was (0.27.0 review) — and only when a worktree is
# listed. A tool that fails is said once, above the worktrees, never read as "nothing
# running": an empty list is what a clean worktree looks like too.
#   processes: `ps`; on Linux with no working ps, /proc/<pid>/cmdline.
#   working directories: /proc/<pid>/cwd, else `lsof -b` (macOS; -b so a dead network
#     mount cannot hang the merge), else none and said so.
#   containers: `docker ps -a`, only when docker is installed, and given 3 seconds —
#     a daemon that is down or starting can hang it, and macOS has no timeout(1).
PROCS=""; CWDS=""; RUN_ERR=""; CONTAINERS=""; DOCKER_ERR=""
load_running() {
  local rc=0 p c
  PROCS=$(ps ax -o pid= -o etime= -o command= 2>/dev/null) || rc=$?
  if [[ $rc -ne 0 || -z "$PROCS" ]]; then
    PROCS=""
    if [[ -r /proc/self/cmdline ]]; then
      for p in /proc/[0-9]*; do
        c=$(tr '\0\n' '  ' < "$p/cmdline" 2>/dev/null) && [[ -n "$c" ]] && PROCS="$PROCS${p#/proc/} ? $c"$'\n'
      done
    fi
    [[ -n "$PROCS" ]] || RUN_ERR="could not list processes (ps exited $rc)"
  fi
  if [[ -r /proc/self/cwd ]]; then
    CWDS=$(for p in /proc/[0-9]*; do c=$(readlink "$p/cwd" 2>/dev/null) && printf '%s %s\n' "${p#/proc/}" "${c//$'\n'/ }"; done)
  elif command -v lsof >/dev/null 2>&1; then
    rc=0; CWDS=$(lsof -b -nP -w -a -d cwd -Fpn 2>/dev/null) || rc=$?
    CWDS=$(printf '%s\n' "$CWDS" | awk '/^p/{p=substr($0,2)} /^n/ && p != "" {print p, substr($0,2)}')
    [[ -n "$CWDS" ]] || RUN_ERR="${RUN_ERR:+$RUN_ERR; }could not read working directories (lsof exited $rc) — command lines only"
  else
    RUN_ERR="${RUN_ERR:+$RUN_ERR; }could not read working directories (no /proc, no lsof) — command lines only"
  fi
}
load_containers() {
  command -v docker >/dev/null 2>&1 || return 0
  local out err pid rc=0 i=0
  out=$(mktemp) && err=$(mktemp) || { DOCKER_ERR="could not list containers (mktemp failed)"; return 0; }
  docker ps -a --filter label=com.docker.compose.project.working_dir \
    --format '{{.ID}}\t{{.Label "com.docker.compose.project.working_dir"}}\t{{.Names}}\t{{.Status}}' >"$out" 2>"$err" &
  pid=$!
  while kill -0 "$pid" 2>/dev/null && [[ $i -lt 30 ]]; do sleep 0.1; i=$((i+1)); done
  if kill -0 "$pid" 2>/dev/null; then
    kill "$pid" 2>/dev/null; wait "$pid" 2>/dev/null
    DOCKER_ERR="could not list containers (docker ps gave no answer in 3s)"
  else
    wait "$pid" || rc=$?
    if [[ $rc -ne 0 ]]; then
      DOCKER_ERR="could not list containers (docker exited $rc: $(shq "$(head -1 "$err" | cut -c1-100)"))"
    else
      CONTAINERS=$(cat "$out")
    fi
  fi
  rm -f "$out" "$err"
}
# running_from <worktree>: the lines for it. A path in a command line counts only at
# the start of a word (after a space, =, or a quote), so /mnt/x/wt does not name /x/wt.
# A command line holding a byte that is not UTF-8 is found by its cwd only: macOS ps
# escapes the rest of such a line, so a non-ASCII path in it does not read as itself.
# The path as given and as `pwd -P` spells it: lsof reports /private/var for /var.
# Through the environment, not awk -v, which reads a backslash in the path as an escape.
running_from() {
  local d="$1" p
  d="${d%/}"; p=$(cd "$d" 2>/dev/null && pwd -P) || p="$d"
  printf '%s\n--\n%s\n' "$CWDS" "$PROCS" | D="$d" P="$p" SELF="$$" NOPS="${PROCS:+0}" awk '
    # q: shq in awk — the same rule, for the same reason: a whole note gets pasted.
    # Split on the quote, not gsub: the backslashes in a gsub replacement differ between
    # awks (macOS awk doubled one and left the quote unmatched). Character by character,
    # with index(), not a bracket regex: macOS awk under a UTF-8 locale dies on a byte
    # that is not UTF-8 in a bracket ("towc: multibyte conversion failure"), and every
    # process after it fell out of the note (fifth review, 2026-10-24).
    function q(s,   t, n, i, part, ok) { ok = (s != "" && substr(s, 1, 1) != "=" && substr(s, 1, 1) != "~"); for (i = 1; ok && i <= length(s); i++) if (!index("ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789._/@+,:-", substr(s, i, 1))) ok = 0; if (ok) return s; n = split(s, part, "\047"); t = "\047" part[1]; for (i = 2; i <= n; i++) t = t "\047\\\047\047" part[i]; return t "\047" }
    function under(s) { return s == ENVIRON["D"] || s == ENVIRON["P"] || index(s, ENVIRON["D"] "/") == 1 || index(s, ENVIRON["P"] "/") == 1 }
    function at(s, x,   i, j, c) {
      j = 0
      while ((i = index(substr(s, j + 1), x)) > 0) {
        j += i; c = (j == 1) ? " " : substr(s, j - 1, 1)
        if (c == " " || c == "=" || c == "\047" || c == "\"") return 1
      }
      return 0
    }
    function names(s) { s = s " "; return at(s, ENVIRON["D"] "/") || at(s, ENVIRON["D"] " ") || at(s, ENVIRON["P"] "/") || at(s, ENVIRON["P"] " ") }
    !body && $0 == "--" { body = 1; next }
    # A row whose pid is not digits, or whose time is not ps etime, is not a process:
    # it is the rest of a name that held a newline, and its fields would be printed
    # unquoted (security review, 2026-10-24). Newlines are spaces where /proc is read.
    function only(s, set,   i) { if (s == "") return 0; for (i = 1; i <= length(s); i++) if (!index(set, substr(s, i, 1))) return 0; return 1 }
    !body { pid = $1; sub(/^[^ ]+ /, ""); if (only(pid, "0123456789") && under($0)) cwd[pid] = 1; next }
    {
      pid = $1; if (!only(pid, "0123456789") || pid == ENVIRON["SELF"]) next
      if ($2 != "?" && !(only($2, "0123456789:-") && index($2, ":"))) next
      cmd = $0; sub(/^[ \t]*[0-9]+[ \t]+[^ \t]+[ \t]+/, "", cmd)
      if (cwd[pid] || names(cmd)) { printf "    pid %s, up %s: %s\n", pid, $2, q(substr(cmd, 1, 120)); done[pid] = 1 }
    }
    END { if (ENVIRON["NOPS"] == "") for (pid in cwd) if (!done[pid] && pid != ENVIRON["SELF"]) printf "    pid %s (command not known: ps failed)\n", pid }'
}
containers_from() {
  local d="$1" p
  d="${d%/}"; p=$(cd "$d" 2>/dev/null && pwd -P) || p="$d"
  [[ -n "$CONTAINERS" ]] || return 0
  printf '%s\n' "$CONTAINERS" | D="$d" P="$p" awk -F '\t' '
    # q: shq in awk — the same rule, for the same reason: a whole note gets pasted.
    # Split on the quote, not gsub: the backslashes in a gsub replacement differ between
    # awks (macOS awk doubled one and left the quote unmatched). Character by character,
    # with index(), not a bracket regex: macOS awk under a UTF-8 locale dies on a byte
    # that is not UTF-8 in a bracket ("towc: multibyte conversion failure"), and every
    # process after it fell out of the note (fifth review, 2026-10-24).
    function q(s,   t, n, i, part, ok) { ok = (s != "" && substr(s, 1, 1) != "=" && substr(s, 1, 1) != "~"); for (i = 1; ok && i <= length(s); i++) if (!index("ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789._/@+,:-", substr(s, i, 1))) ok = 0; if (ok) return s; n = split(s, part, "\047"); t = "\047" part[1]; for (i = 2; i <= n; i++) t = t "\047\\\047\047" part[i]; return t "\047" }
    function under(s) { return s != "" && (s == ENVIRON["D"] || s == ENVIRON["P"] || index(s, ENVIRON["D"] "/") == 1 || index(s, ENVIRON["P"] "/") == 1) }
    under($2) { printf "    container %s (%s), %s — from %s\n", q($1), q($3), q($4), q($2) }'
}
if [[ ${#STALE_WORKTREES[@]} -gt 0 ]]; then
  load_running
  load_containers
fi

# note_branch <branch> [just]: the command on a line of its own, what to know about it on
# the next. On the same line, "← just merged" was pasted along with the command, and
# `git branch -d fix/x  ← just merged` deleted merged branches named `just` and
# `merged` too (fix review, 2026-10-24). Not a trailing `#`: interactive zsh has
# comments off and hands `#` to git.
note_branch() {
  local why; why=$(refused_until "$1")
  printf '  git branch -d %s\n' "$(shq "$1")"
  if [[ -n "${2-}" ]]; then printf '    ↑ just merged%s\n' "${why:+; $why}"
  elif [[ -n "$why" ]]; then printf '    ↑ %s\n' "$why"; fi
}

# --- Write note file ---
mkdir -p "$(dirname "$NOTE_FILE")"
# The note is this hook's file, not the project's: unless the project already ignores
# it, it goes in this clone's info/exclude, so the first merge does not leave an
# untracked .claude/ in git status (hooks review H20, 2026-10-28). Not .gitignore:
# that would be a change to commit. Cosmetic, so a write that fails says nothing. A note
# the project tracks is ignored by nothing, so it is left alone, and a line already there
# is not written again: every merge added one (0.28.0 release review).
if ! git check-ignore -q "$NOTE_PATH" 2>/dev/null \
    && ! git ls-files --error-unmatch -- "$NOTE_PATH" >/dev/null 2>&1; then
  # A file whose last line has no newline would have the rule glued onto it (fix review).
  _ex=$(git rev-parse --git-path info/exclude 2>/dev/null) && [[ -n "$_ex" ]] \
    && ! grep -qxF "/$NOTE_PATH" "$_ex" 2>/dev/null \
    && mkdir -p "$(dirname "$_ex")" 2>/dev/null \
    && { [[ ! -s "$_ex" || -z "$(tail -c1 "$_ex")" ]] || printf '\n' >> "$_ex"; } 2>/dev/null \
    && printf '/%s\n' "$NOTE_PATH" >> "$_ex" 2>/dev/null || true
fi
{
  # Every name from outside the hook — a branch, a path, an upstream, a command line, a
  # container, docker's own words — goes through shq, on every line, not only the
  # commands: a whole note gets pasted, and a name holding ; or a backtick ran what
  # followed it on whatever line it sat (security review, 2026-10-24). The header lost
  # its backticks: pasted, `name` is a command substitution.
  echo "## Post-merge to $(shq "$INTEGRATION_BRANCH"): $(shq "$MERGED_BRANCH")"
  echo ""

  if [[ ${#STALE_WORKTREES[@]} -gt 0 ]]; then
    echo "### ⚠ Worktrees still present (remove after confirming work is merged):"
    # A tool that failed is said once, here: it failed for every worktree alike, and
    # under each one it repeated (Docker Desktop not running: one line per worktree —
    # fix review, 2026-10-24, D4). It is never read as nothing running.
    [[ -n "$RUN_ERR" ]] && echo "  ⚠ $RUN_ERR"
    [[ -n "$DOCKER_ERR" ]] && echo "  ⚠ $DOCKER_ERR"
    for wt in "${STALE_WORKTREES[@]}"; do
      rel="${wt#$REPO_ROOT/}"
      wt_branch=$(git -C "$wt" branch --show-current 2>/dev/null || echo "?")
      echo "  Branch: $(shq "$wt_branch")  →  $(shq "$rel")"
      _run=$(running_from "$wt"; containers_from "$wt")
      # Read, never run: a byte that is not UTF-8 in a command line is dropped, so the note
      # stays text (inside '…' quoting, removing a byte cannot change how a line parses).
      # Without iconv, or if it prints nothing, the lines stay as they were.
      _clean=$(printf '%s\n' "$_run" | iconv -f UTF-8 -t UTF-8 -c 2>/dev/null) && [[ -n "$_clean" ]] && _run=$_clean
      _run=$(printf '%s\n' "$_run" | grep -v '^$' || true)
      if [[ -n "$_run" ]]; then
        echo "  Still running from it, or left by it — stop or remove what a check started there before removing the worktree — docker compose down from its directory, or docker rm and the container id; ask before stopping anything you did not start:"
        echo "$_run"
      fi
      # Quoted by shq: the line is printed to be pasted, and a path — or a branch name
      # below, which git allows to hold ' ; $ { } — closed a bare '…' and ran what
      # followed: `x';touch${IFS}PWNED;'` is a valid branch (fix review, 2026-10-24, Q2).
      printf '  git worktree remove %s\n' "$(shq "$rel")"
    done
  else
    echo "### Worktrees: none stale ✓"
  fi

  echo ""

  if [[ -n "$ALL_MERGED" ]]; then
    echo "### ⚠ Branches merged into $(shq "$INTEGRATION_BRANCH") (safe to delete):"
    # Merged straight from origin/<x> with no local <x>, there is nothing to delete.
    # Never a protected branch: the merged-in side of a back-merge is main, and the note
    # offered `git branch -d main` as safe to delete — ALL_MERGED filters protected names,
    # this line did not (fix review of 0.28.0's release review).
    if [[ -n "$JUST_MERGED" && "$JUST_MERGED" != "unknown" ]] \
       && ! printf '%s' "$JUST_MERGED" | grep -qiE -e "$PROTECTED_RE" 2>/dev/null \
       && git show-ref --verify -q "refs/heads/$JUST_MERGED"; then
      note_branch "$JUST_MERGED" just
    fi
    if [[ -n "$PREVIOUSLY_MERGED" ]]; then
      echo "  (previously merged, not yet deleted:)"
      while IFS= read -r branch; do
        [[ -n "$branch" ]] && note_branch "$branch"
      done <<< "$PREVIOUSLY_MERGED"
    fi
  else
    echo "### Branches: none to delete ✓"
  fi
} > "$NOTE_FILE"

# Printed as well as written: no flight-rules hook reads the file (#110; a user's own
# hook may), so the merger — the owner or an assistant — sees it here. Only what this
# merge left is printed in full — its worktree, what still runs from it, its branch —
# and what earlier merges left as one count line. Re-listing every earlier worktree and
# branch on every merge, and the whole note on every pull, was noise that hid the new
# line (hooks review H21, 2026-10-28; MISSION.md principle 5). A pull, a fast-forward or
# a back-merge prints nothing; the file has everything. At most 40 lines.
PRINT=""
if is_feature_merge; then
  # Read back from the note, not worked out again: the process list is read once.
  # ENVIRON, not awk -v, which would read a backslash in a name as an escape.
  _blk=$(B="  Branch: $(shq "$JUST_MERGED")  →" awk 'index($0, ENVIRON["B"]) == 1 {p=1}
    p {print} p && /^  git worktree remove / {exit}' "$NOTE_FILE")
  _brl=$(L="  git branch -d $(shq "$JUST_MERGED")" awk '$0 == ENVIRON["L"] {print; if ((getline n) > 0 && n ~ /^    ↑/) print n; exit}' "$NOTE_FILE")
  _old_wt=${#STALE_WORKTREES[@]}; [[ -n "$_blk" ]] && _old_wt=$((_old_wt - 1))
  _old_br=$(printf '%s\n' "$PREVIOUSLY_MERGED" | grep -c . || true)
  if [[ -n "$_blk" ]]; then
    PRINT+="### ⚠ Its worktree is still present (remove after confirming work is merged):"$'\n'
    [[ -n "$RUN_ERR" ]] && PRINT+="  ⚠ $RUN_ERR"$'\n'
    [[ -n "$DOCKER_ERR" ]] && PRINT+="  ⚠ $DOCKER_ERR"$'\n'
    PRINT+="$_blk"$'\n'
  fi
  [[ -n "$_brl" ]] && PRINT+="### ⚠ Its branch is merged (safe to delete):"$'\n'"$_brl"$'\n'
  if [[ "$_old_wt" -gt 0 || "$_old_br" -gt 0 ]]; then
    PRINT+="Earlier merges left $_old_wt worktree(s) and $_old_br branch(es) to clean up — listed in $NOTE_PATH"$'\n'
  fi
  [[ -n "$PRINT" ]] && PRINT="## Post-merge to $(shq "$INTEGRATION_BRANCH"): $(shq "$MERGED_BRANCH")"$'\n'"$PRINT"
fi
if [[ -n "$PRINT" ]]; then
  echo ""
  _n=$(printf '%s' "$PRINT" | wc -l | tr -d ' ')
  printf '%s' "$PRINT" | head -40
  [[ "$_n" -gt 40 ]] && echo "  … $((_n - 40)) more lines in $NOTE_PATH"
  echo ""
fi
if [[ -n "$PRINT" ]]; then
  echo "✅ post-merge: cleanup note written to $NOTE_PATH."
fi
exit 0
