#!/usr/bin/env bash
# commit-msg hook — the note gate (merge-gate mechanism 2), plus the squash guard.
#
# Lives here rather than in pre-merge-commit because modern git (verified on
# 2.55) writes MERGE_HEAD *after* pre-merge-commit runs. The note lookup there
# never found the incoming commit, so the gate was a silent no-op — the worst
# kind of guard, one that reports nothing and enforces nothing. commit-msg runs
# while the merge is in progress with MERGE_HEAD present, so the check works.
#
# For a NON-merge commit MERGE_HEAD is absent and this hook exits 0 immediately:
# it gates merges only, never ordinary commits. PR-only branches (default `main`)
# are handled by pre-merge-commit and blocked before reaching this hook — except
# for a squash merge, which creates no merge commit and so never fires
# pre-merge-commit; that case is caught here (see below).
#
# Configuration — first match wins:
#   1. Environment              FLIGHT_RULES_NOTE_GATED_BRANCHES='^(dev|staging)$'
#                               FLIGHT_RULES_PR_ONLY_BRANCHES='^main$'
#   2. .ai/flight-rules.conf **as committed on the merge target** (see below)
#   3. The defaults below
# Parsed as data, never sourced, so a cloned repo cannot execute code here.
#
# ⚠️ The conf is read from `HEAD:.ai/flight-rules.conf` — the merge TARGET's committed
#    state — NOT from the working tree. During a merge git updates the working tree
#    before this hook runs, so a working-tree read would hand the incoming branch
#    control over the gate that judges it: a branch shipping
#    `NOTE_GATED_BRANCHES=^nothing$` would wave itself through. Reading from HEAD is
#    also the semantically right answer — the gate enforces the policy of the branch
#    you are merging INTO. If HEAD has no conf, fall back to the default rather than
#    to the working tree; failing open would restore the hole.
#
#    The plugin's agent guard, pre-commit-check.sh, deliberately still reads the
#    working tree: it guards against mistakes in an interactive session, where an
#    uncommitted config edit SHOULD take effect immediately. Only the merge gate has
#    to resist the thing it is gating.
#
# Install: commit this file into the project's hooks dir (e.g. .ai/hooks/) and run
# install.sh once per clone.
#
# No bypass is printed. The note gate is what keeps unreviewed work out of the branch,
# and a refusal that hands the reader a working skip — an assistant included, which no
# guard stops from running it — undoes it; the one it used to print, `git merge
# --no-verify`, failed mid-merge anyway (owner, 2026-10-26). Someone who means to
# bypass a hook knows --no-verify (hooks/README.md, "What these hooks are").

set -euo pipefail

# NOTE_GATED_BRANCHES has no default branch NAMES. It used to default to
# `^(dev|staging)$`, which silently decided that a project's second protected branch
# was called one of those two: a project using `trunk`/`qa`, or protecting a
# long-lived feature branch, got no note gate at all and nothing said so. The set is
# derivable — a branch that is protected but does NOT move only through a PR is
# exactly the one where a local merge is allowed and should carry a stamp — so it is
# derived rather than named. An explicit NOTE_GATED_BRANCHES still wins.
DEFAULT_PROTECTED='^(main|master|dev|develop|development|staging|stage|qa|uat|prod|production)$|^release(/|$)'
DEFAULT_PR_ONLY='^main$'
CONF_PATH='.ai/flight-rules.conf'   # repo-relative

read_conf_at_head() {
  local key="$1" path="$2" content
  # return 0, not 1, on a missing file: these hooks run under `set -e`, so a failure
  # status here would abort the hook and block every commit in a repo with no conf.
  content=$(git show "HEAD:$path" 2>/dev/null) || return 0
  printf '%s\n' "$content" \
    | sed -n -E "s/^[[:space:]]*${key}[[:space:]]*=[[:space:]]*(.*)$/\1/p" \
    | sed -E 's/[[:space:]]+#.*$//; s/[[:space:]]+$//; s/^"(.*)"$/\1/; s/^'\''(.*)'\''$/\1/' \
    | tail -1
}

NOTE_GATED_RE="${FLIGHT_RULES_NOTE_GATED_BRANCHES:-$(read_conf_at_head NOTE_GATED_BRANCHES "$CONF_PATH")}"
PR_ONLY_RE="${FLIGHT_RULES_PR_ONLY_BRANCHES:-$(read_conf_at_head PR_ONLY_BRANCHES "$CONF_PATH")}"
PR_ONLY_RE="${PR_ONLY_RE:-$DEFAULT_PR_ONLY}"
PROTECTED_RE_CONF="${FLIGHT_RULES_PROTECTED_BRANCHES:-$(read_conf_at_head PROTECTED_BRANCHES "$CONF_PATH")}"
PROTECTED_RE_CONF="${PROTECTED_RE_CONF:-$DEFAULT_PROTECTED}"

CURRENT_BRANCH=$(git branch --show-current)

# Ask git for the git-dir rather than assuming ./.git — the path differs between
# the main worktree and supplementary worktrees.
GIT_DIR=$(git rev-parse --git-dir)

# --- Box drawing --------------------------------------------------------------
# A blocked merge scrolls past in a wall of terminal output; the box makes it
# impossible to miss. Duplicated verbatim in pre-merge-commit and pre-rebase: git
# hooks are copied into projects individually and must stay self-contained, so a
# shared library would be one more file to keep in sync for eight lines of
# formatting.
#
# `adj` is the number of EXTRA display columns the row's content occupies beyond
# its character count — bash's ${#s} counts characters, and an emoji is one
# character but two columns, so a row containing one emoji passes adj=1. Getting
# it wrong shifts that row's right border by a column; it is cosmetic only.
BOX_W=68
_rule() { local c="$1" n=$BOX_W out=''; while [ $n -gt 0 ]; do out="$out$c"; n=$((n-1)); done; printf '%s' "$out"; }
box_top() { printf '╔%s╗\n' "$(_rule ═)"; }
box_sep() { printf '╠%s╣\n' "$(_rule ═)"; }
box_bot() { printf '╚%s╝\n' "$(_rule ═)"; }
box_row() {
    local s="${1:-}" adj="${2:-0}" pad
    pad=$(( BOX_W - ${#s} - 2 - adj ))
    [ "$pad" -lt 0 ] && pad=0
    printf '║ %s%*s ║\n' "$s" "$pad" ''
}

# A refusal a broken pattern decided: the pattern named, where it is set, and the
# command that gets past the gate it broke from where this refusal leaves you — the one
# that finishes or repeats what was refused, never a second `git merge`, which an
# unfinished merge refuses (#103 review; #100 was the same mistake). The route is for a
# branch the pattern does not mean; on one it does, the pattern meant refuses as well.
# <key> <value> <what> <branch> <command>
broken_box() {
    echo ""
    box_top
    box_row "⛔  $1 DOES NOT COMPILE — $3 BLOCKED" 1
    box_sep
    box_row ""
    box_row "$1 is not a pattern that compiles:"
    box_row "  $2"
    box_row "so every branch is taken as matching it until it is fixed."
    box_row ""
    box_row "The project owner fixes it in .ai/flight-rules.conf, on a"
    box_row "branch, or in FLIGHT_RULES_$1. Until that fix"
    box_row "has landed, and if $4 is not a branch it means,"
    box_row "give the pattern meant in front of this command:"
    box_row "  FLIGHT_RULES_$1='<pattern>' \\"
    box_row "    $5"
    box_row "keeping any other FLIGHT_RULES_ setting it carried."
    box_row ""
    box_bot
    echo ""
}

# re_rc <string> <pattern> [exact]: 0 match, 1 no match, 2 the pattern does not
# compile. A broken pattern used to read as "no match" (#103). Where a match imposes a
# gate, 2 counts as a match; where it grants an exemption, it does not — so a broken
# pattern turns no gate off and no exemption on. `off` matches nothing (#103 review).
# A gate matches case-insensitively, as the agent guard matches: `^(MAIN|DEV)$` let an
# unstamped merge into dev through (#103 review). An exemption matches `exact`: read
# case-insensitively, `^main$` took a branch anyone can make — `MAIN`, or `Main` pushed
# to origin — for main, and passed it as a reviewed back-merge (#103 review). A pattern
# in the wrong case then gates what it meant to exempt, and the refusal says so.
re_rc() {
    local r=0
    [ "$2" = "off" ] && return 1
    [ "${3:-}" = exact ] || shopt -s nocasematch
    [[ "$1" =~ $2 ]] || r=$?
    shopt -u nocasematch
    return "$r"
}

# --- Squash guard for PR-only branches ----------------------------------------
# `git merge --squash --ff feature` on main stages the result and writes
# SQUASH_MSG but creates no merge commit, so pre-merge-commit never fires and the
# following `git commit` would land the whole feature on a PR-only branch as one
# ordinary commit. That commit is the one to refuse.
_rc=0; re_rc "$CURRENT_BRANCH" "$PR_ONLY_RE" || _rc=$?
if [ "$_rc" -eq 2 ] && [ -f "$GIT_DIR/SQUASH_MSG" ]; then
    broken_box PR_ONLY_BRANCHES "$PR_ONLY_RE" "SQUASH MERGE" "$CURRENT_BRANCH" "git commit <same arguments>"
    echo "Undo:   git reset --merge   (drops the squashed changes)"
    exit 1
fi
if [ "$_rc" -eq 0 ] && [ -f "$GIT_DIR/SQUASH_MSG" ]; then
    echo ""
    box_top
    box_row "⛔  $CURRENT_BRANCH IS PR-ONLY — SQUASH MERGE BLOCKED" 1
    box_sep
    box_row ""
    box_row "A squash merge is still a local merge into $CURRENT_BRANCH."
    box_row "It moves only through a reviewed pull request."
    box_row ""
    box_row "Undo:   git reset --merge   (drops the squashed changes)"
    box_row "Then open a PR from the feature branch instead."
    box_row ""
    box_bot
    echo ""
    exit 1
fi

# --- Note gate for note-gated branches ----------------------------------------
# Explicit configuration wins. With none, the gated set is "protected but not
# PR-only": a PR-only branch takes no local merge at all (the ref gate refuses it),
# so the branches left needing a stamp are exactly the other protected ones —
# whatever this project calls them.
# BROKEN names a gating key whose pattern does not compile, for the refusal to say.
BROKEN=""; BROKEN_RE=""
if [ -n "$NOTE_GATED_RE" ]; then
    [ "$NOTE_GATED_RE" = "off" ] && exit 0
    _rc=0; re_rc "$CURRENT_BRANCH" "$NOTE_GATED_RE" || _rc=$?
    [ "$_rc" -eq 1 ] && exit 0
    [ "$_rc" -eq 2 ] && { BROKEN=NOTE_GATED_BRANCHES; BROKEN_RE=$NOTE_GATED_RE; }
else
    [ "$PROTECTED_RE_CONF" = "off" ] && exit 0
    _rc=0; re_rc "$CURRENT_BRANCH" "$PROTECTED_RE_CONF" || _rc=$?
    [ "$_rc" -eq 1 ] && exit 0
    [ "$_rc" -eq 2 ] && { BROKEN=PROTECTED_BRANCHES; BROKEN_RE=$PROTECTED_RE_CONF; }
    # An exemption: only a real match, in the pattern's case, counts.
    _rc=0; re_rc "$CURRENT_BRANCH" "$PR_ONLY_RE" exact || _rc=$?
    [ "$_rc" -eq 0 ] && exit 0
fi

# MERGE_HEAD present ⇒ a merge is in progress. Absent ⇒ ordinary commit, nothing to
# gate.
MERGE_HEAD_FILE="$GIT_DIR/MERGE_HEAD"
[ -f "$MERGE_HEAD_FILE" ] || exit 0

MERGE_SHA=$(cat "$MERGE_HEAD_FILE")

# A back-merge — the incoming commit is the tip of a PR-only branch (default main)
# — needs no note. Everything on that branch arrived through a reviewed pull
# request, and reconciling it into the integration branch is routine maintenance,
# not a feature landing (post-merge makes the same distinction). Without this,
# `git merge main` on dev was blocked for want of a note nobody could stamp.
#
# Only `refs/heads/<x>` and `refs/remotes/origin/<x>` count — a stale
# `upstream/main` or a fork's remote is not evidence of review. And because a local
# branch can be pointed anywhere (`git branch -f main feature/x`), when origin has
# the branch the commit must actually be on it. PR_ONLY_BRANCHES is read from HEAD
# like everything else here, so the incoming branch cannot declare itself PR-only.
# The origin side is looked up ignoring case: a local MAIN, with origin holding main,
# found no origin/MAIN and skipped that check, so a pattern given as ^MAIN$ passed an
# unstamped commit as a reviewed back-merge (0.27.0 release review).
# CASE_ONLY names a ref that matched only ignoring case, for the refusal to say.
# OFF_REFS lists, space-separated (a refname has no spaces or glob characters), every
# origin ref that matches a PR-only branch at this commit, ignoring case, and lacks it; OFF_SHORT names those branches, NO_EXACT the ones origin
# has under no ref spelled as they are. The refusal states those facts and judges
# nothing: three rounds of text that guessed which ref was real, stray or in the wrong
# case each misled in a new shape, once advising deletion of origin/main (fix reviews).
# MULTI is set when origin has more than one ref matching such a branch ignoring case,
# the one shape where "which is the PR-only branch" is a question at all.
CASE_ONLY=""; OFF_REFS=""; OFF_SHORT=""; NO_EXACT=""; MULTI=""
while read -r ref sha; do
    case "$ref" in
        refs/heads/*)          short="${ref#refs/heads/}" ;;
        refs/remotes/origin/*) short="${ref#refs/remotes/origin/}" ;;
        *)                     continue ;;
    esac
    [ "$sha" = "$MERGE_SHA" ] || continue
    # An exemption: only a real match, in the pattern's case, counts. Read as matching
    # every branch, a broken PR_ONLY_BRANCHES would take every merge for a back-merge
    # needing no note (#103); see re_rc for the case.
    case_only=""
    if ! re_rc "$short" "$PR_ONLY_RE" exact; then
        re_rc "$short" "$PR_ONLY_RE" || continue
        case_only=1
    fi
    # Every case variant origin has must hold the commit, not any one of them: anyone can
    # push a MAIN beside main (security review of this fix).
    exact=""; lacking=""; nmatch=0
    while read -r oref osha; do
        o=${oref#refs/remotes/origin/}
        shopt -s nocasematch; m=""
        [[ "$o" == "$short" ]] && m=1
        shopt -u nocasematch
        [ -n "$m" ] || continue
        nmatch=$((nmatch+1))
        [ "$o" = "$short" ] && exact=1
        git merge-base --is-ancestor "$MERGE_SHA" "$osha" 2>/dev/null && continue
        lacking="$lacking origin/$o"
    done < <(git for-each-ref --format='%(refname) %(objectname)' refs/remotes/origin)
    if [ -n "$lacking" ]; then
        # A case-only ref is not the PR-only branch, so its origin refs are not this
        # refusal's to list: the generic note-gate box answers it (#103 review).
        if [ -z "$case_only" ]; then
            for _r in $lacking; do
                case " $OFF_REFS " in *" $_r "*) ;; *) OFF_REFS="${OFF_REFS:+$OFF_REFS }$_r" ;; esac
            done
            case " $OFF_SHORT " in *" $short "*) ;; *) OFF_SHORT="${OFF_SHORT:+$OFF_SHORT }$short" ;; esac
            [ "$nmatch" -gt 1 ] && MULTI=1
            [ -n "$exact" ] || case " $NO_EXACT " in *" $short "*) ;; *) NO_EXACT="${NO_EXACT:+$NO_EXACT }$short" ;; esac
        fi
        continue
    fi
    # Named only once the rest has passed: a forced local main is refused by origin's
    # check, and blaming the case would mislead (#103 review). The refusal prints no
    # command for it: the one it printed, pasted with ^MAIN$, made a local MAIN a
    # reviewed back-merge (0.27.0 release review).
    [ -n "$case_only" ] && { CASE_ONLY="$short"; continue; }
    echo "✅ Back-merge of PR-only branch $short into $CURRENT_BRANCH — already reviewed, no note needed"
    exit 0
done < <(git for-each-ref --format='%(refname) %(objectname)' refs/heads refs/remotes/origin)

MERGE_BRANCH=$(git name-rev --name-only "$MERGE_SHA" 2>/dev/null || echo "$MERGE_SHA")

NOTE=$(git notes --ref=pre-merge-check show "$MERGE_SHA" 2>/dev/null || true)

if echo "$NOTE" | grep -q "^passed:"; then
    # The note proves a check ran. It does NOT prove anyone asked for this merge:
    # the agent writes the note itself, so a stamped merge that nobody requested
    # used to print a green tick and land silently (measured 2026-09-10 — the
    # advisory produced no warning of any kind, only "✅ Pre-merge check verified").
    #
    # Nothing inside an assistant's own tool calls can distinguish "the user asked"
    # from "the agent decided" — any token the hook demands, the agent can supply.
    # So this does not claim proof. It makes the unbidden merge a deliberate, named
    # act instead of a silent one, and writes which path was taken into the merge
    # commit, where it survives and can be grepped.
    NEEDS_INSTRUCTION=$(read_conf_at_head MERGE_NEEDS_INSTRUCTION "$CONF_PATH")
    NEEDS_INSTRUCTION="${NEEDS_INSTRUCTION:-on}"
    AUTHORISED="${FLIGHT_RULES_MERGE_AUTHORISED:-}"
    [ "$AUTHORISED" = "0" ] && AUTHORISED=""

    if [ "$NEEDS_INSTRUCTION" = "off" ]; then
        TRAILER="Merge-authorisation: not required (MERGE_NEEDS_INSTRUCTION=off)"
    elif [ -n "$AUTHORISED" ]; then
        TRAILER="Merge-authorisation: explicit (FLIGHT_RULES_MERGE_AUTHORISED)"
    else
        echo ""
        box_top
        box_row "❌  WHO ASKED FOR THIS MERGE?" 1
        box_sep
        box_row ""
        box_row "Merging: $MERGE_BRANCH"
        box_row "Into:    $CURRENT_BRANCH  (protected)"
        box_row ""
        box_row "The pre-merge-check note passed — but the agent writes"
        box_row "that note itself, so it shows a check ran, not that"
        box_row "anyone wanted this branch merged."
        box_row ""
        # The conclude form, not `git merge <branch>`: this hook refusing leaves the
        # merge in progress (MERGE_HEAD stays, clean merge or conflicted), and a second
        # `git merge` fails with "You have not concluded your merge" — the command
        # printed here never worked (AppliHawk, 2026-10-21, #100).
        box_row "If the user asked for it, say so and finish the merge:"
        box_row "  FLIGHT_RULES_MERGE_AUTHORISED=1 git commit --no-edit"
        box_row ""
        box_row "If they did not: stop, and ask. Setting that variable"
        box_row "to get unblocked is the whole thing this prevents,"
        box_row "and it is recorded in the merge commit either way."
        box_row ""
        box_row "If this project does not want the check, its owner"
        box_row "sets MERGE_NEEDS_INSTRUCTION=off in"
        box_row "  .ai/flight-rules.conf"
        box_row "That is the owner's call — do not set it yourself."
        box_row ""
        box_row "Undo this half-finished merge:   git merge --abort"
        box_row "  — it also drops what you staged. A merge you never"
        box_row "  started is a leftover: check git status first."
        box_row ""
        box_bot
        echo ""
        exit 1
    fi

    # Record it in the commit message: a note can be rewritten and is easy to miss,
    # the message travels with the merge forever. Appended only if absent, so an
    # amend or a rerun does not stack duplicates. interpret-trailers, not a printf
    # of '\n%s\n': the file git hands this hook for a non-interactive merge ends
    # without a trailing newline, so that leading newline only closed the subject
    # and the line landed glued to it — greppable, but no trailer parser saw it,
    # and %s carried it into every `git log --oneline` (#62, observed on dev at
    # c3a708e). interpret-trailers supplies the blank line itself and places the
    # trailer before any comment block when the message is being edited.
    if [ -n "${1:-}" ] && [ -f "$1" ] && ! grep -q '^Merge-authorisation:' "$1"; then
        git interpret-trailers --in-place --trailer "$TRAILER" "$1"
    fi
    echo "✅ Pre-merge check verified for $MERGE_BRANCH → $CURRENT_BRANCH"
    echo "   ${TRAILER}"
    exit 0
fi

# A plain `git pull` that only catches up with the branch's own upstream lands here
# too: merge.ff=false makes even that a merge commit (hooks review H1, 2026-10-28). It
# is not let through, and pull.ff is not set for it — either lets `git pull origin
# <any branch>` fast-forward a protected branch past every gate (probed 2026-10-29).
# The refusal names it and prints the pull that works.
CATCHUP=""
_up=$(git rev-parse -q --verify '@{upstream}' 2>/dev/null) \
    && [ "$_up" = "$MERGE_SHA" ] \
    && git merge-base --is-ancestor HEAD "$_up" 2>/dev/null \
    && CATCHUP=$(git rev-parse --abbrev-ref '@{upstream}' 2>/dev/null)

# Both boxes say what `--abort` costs: it runs `reset --merge`, and on a leftover
# MERGE_HEAD nobody is merging it deleted the staged work beside it (final release
# /dg, 2026-10-18). For a real refused merge it is still the undo.
echo ""
box_top
box_row "❌  PRE-MERGE CHECK REQUIRED" 1
box_sep
box_row ""
box_row "Merging: $MERGE_BRANCH"
box_row "Into:    $CURRENT_BRANCH"
box_row ""
if [ -n "$BROKEN" ]; then
    # The refused merge is still in progress, so the route finishes it with a commit
    # (#103 review): a sync merge into a feature branch had no route here at all.
    box_row "Gated because $BROKEN ($BROKEN_RE)"
    box_row "does not compile: every branch is taken as gated until"
    box_row "the project owner fixes it (.ai/flight-rules.conf, or"
    box_row "FLIGHT_RULES_$BROKEN in the environment). If"
    box_row "$CURRENT_BRANCH is not a branch it means, give the pattern"
    box_row "meant in front of the command:"
    box_row "  FLIGHT_RULES_$BROKEN='<pattern>' \\"
    box_row "    git commit --no-edit"
    box_row ""
fi
if [ -n "$CASE_ONLY" ]; then
    box_row "Not taken for a back-merge: $CASE_ONLY matches"
    box_row "PR_ONLY_BRANCHES ($PR_ONLY_RE) only ignoring case,"
    box_row "and that exemption takes the pattern's exact case. If"
    box_row "$CASE_ONLY is the PR-only branch, the project owner"
    box_row "writes the pattern in its case in .ai/flight-rules.conf."
    box_row ""
fi
if [ -n "$OFF_SHORT" ]; then
    # Facts only, and no ref name inside a command: anyone who can push picks one.
    box_row "Not taken for a back-merge: $OFF_SHORT matches"
    box_row "PR_ONLY_BRANCHES, but this commit is not on:"
    _n=0
    for _r in $OFF_REFS; do
        _n=$((_n+1)); [ "$_n" -le 5 ] && box_row "  $_r"
    done
    [ "$_n" -gt 5 ] && box_row "  … and $((_n-5)) more"
    box_row "Every origin ref that matches it ignoring case must"
    box_row "hold the commit."
    # What the hook knows is what was last fetched: it makes no network call.
    for _b in $NO_EXACT; do
        box_row "As of the last fetch, origin has no ref spelled $_b."
    done
    if [ -n "$MULTI" ] || [ -n "$NO_EXACT" ]; then
        box_row "Which is the PR-only branch is the project owner's call."
    fi
    box_row "If origin has moved on since the last fetch:"
    box_row "  git fetch --prune origin"
    box_row "  git commit --no-edit"
    box_row ""
fi
if [ -n "$CATCHUP" ]; then
    box_row "This merge only catches up with"
    box_row "$CATCHUP; merge.ff=false made it a merge commit."
    box_row "Undo it (below), and catch up without one:"
    box_row "  git pull --ff-only"
else
    box_row "Run /pre-merge-check in the feature worktree first. When"
    box_row "every check passes it stamps a note on the commit, and"
    box_row "this hook lets the merge through."
    box_row ""
    # The developer working alone is served as much as one with an assistant
    # (MISSION.md principle 5): a slash command was the only route printed (hooks review
    # H3, 2026-10-28). Described, with the command in the README, not printed ready to
    # paste: an assistant reads this box too, and takes the route it prints (commit
    # security review, 2026-10-29).
    box_row "Working without an assistant: run the project's checks"
    box_row "yourself — its tests at the least — then record what ran"
    box_row "as a note on the branch's tip (hooks/README.md → commit-msg"
    box_row "has the command) and finish the merge. An assistant runs"
    box_row "/pre-merge-check instead: only running it may write the note."
fi
box_row ""
box_row "Undo this half-finished merge:   git merge --abort"
box_row "  — it also drops what you staged. A merge you never"
box_row "  started is a leftover: check git status first."
box_row ""
box_bot
echo ""
exit 1
