#!/usr/bin/env bash
# commit-msg hook — the note gate (merge-gate mechanism 2), plus the squash guard.
#
# Lives here rather than in pre-merge-commit because modern git (verified on
# 2.55) writes MERGE_HEAD *after* pre-merge-commit runs. The note lookup there
# never found the incoming commit, so the gate was a silent no-op — the worst
# kind of guard, one that reports nothing and enforces nothing. commit-msg runs
# while the merge is in progress with MERGE_HEAD present, so the check works.
#
# For a NON-merge commit MERGE_HEAD is absent and this hook exits 0 immediately:
# it gates merges only, never ordinary commits. PR-only branches (default `main`)
# are handled by pre-merge-commit and blocked before reaching this hook — except
# for a squash merge, which creates no merge commit and so never fires
# pre-merge-commit; that case is caught here (see below).
#
# Configuration — first match wins:
#   1. Environment              FLIGHT_RULES_NOTE_GATED_BRANCHES='^(dev|staging)$'
#                               FLIGHT_RULES_PR_ONLY_BRANCHES='^main$'
#   2. .ai/flight-rules.conf **as committed on the merge target** (see below)
#   3. The defaults below
# Parsed as data, never sourced, so a cloned repo cannot execute code here.
#
# ⚠️ The conf is read from `HEAD:.ai/flight-rules.conf` — the merge TARGET's committed
#    state — NOT from the working tree. During a merge git updates the working tree
#    before this hook runs, so a working-tree read would hand the incoming branch
#    control over the gate that judges it: a branch shipping
#    `NOTE_GATED_BRANCHES=^nothing$` would wave itself through. Reading from HEAD is
#    also the semantically right answer — the gate enforces the policy of the branch
#    you are merging INTO. If HEAD has no conf, fall back to the default rather than
#    to the working tree; failing open would restore the hole.
#
#    hooks/agent/pre-commit-check.sh deliberately still reads the working tree: it
#    guards against mistakes in an interactive session, where an uncommitted config
#    edit SHOULD take effect immediately. Only the merge gate has to resist the thing
#    it is gating.
#
# Install: commit this file into the project's hooks dir (e.g. .ai/hooks/) and run
# install.sh once per clone.
#
# Bypass (breaks the rules — emergencies only):  git merge --no-verify

set -euo pipefail

DEFAULT_NOTE_GATED='^(dev|staging)$'
DEFAULT_PR_ONLY='^main$'
CONF_PATH='.ai/flight-rules.conf'   # repo-relative

read_conf_at_head() {
  local key="$1" path="$2" content
  # return 0, not 1, on a missing file: these hooks run under `set -e`, so a failure
  # status here would abort the hook and block every commit in a repo with no conf.
  content=$(git show "HEAD:$path" 2>/dev/null) || return 0
  printf '%s\n' "$content" \
    | sed -n -E "s/^[[:space:]]*${key}[[:space:]]*=[[:space:]]*(.*)$/\1/p" \
    | sed -E 's/[[:space:]]+$//; s/^"(.*)"$/\1/; s/^'\''(.*)'\''$/\1/' \
    | tail -1
}

PROTECTED_RE="${FLIGHT_RULES_NOTE_GATED_BRANCHES:-$(read_conf_at_head NOTE_GATED_BRANCHES "$CONF_PATH")}"
PROTECTED_RE="${PROTECTED_RE:-$DEFAULT_NOTE_GATED}"
PR_ONLY_RE="${FLIGHT_RULES_PR_ONLY_BRANCHES:-$(read_conf_at_head PR_ONLY_BRANCHES "$CONF_PATH")}"
PR_ONLY_RE="${PR_ONLY_RE:-$DEFAULT_PR_ONLY}"

CURRENT_BRANCH=$(git branch --show-current)

# Ask git for the git-dir rather than assuming ./.git — the path differs between
# the main worktree and supplementary worktrees.
GIT_DIR=$(git rev-parse --git-dir)

# --- Box drawing --------------------------------------------------------------
# A blocked merge scrolls past in a wall of terminal output; the box makes it
# impossible to miss. Duplicated verbatim in pre-merge-commit and pre-rebase: git
# hooks are copied into projects individually and must stay self-contained, so a
# shared library would be one more file to keep in sync for eight lines of
# formatting.
#
# `adj` is the number of EXTRA display columns the row's content occupies beyond
# its character count — bash's ${#s} counts characters, and an emoji is one
# character but two columns, so a row containing one emoji passes adj=1. Getting
# it wrong shifts that row's right border by a column; it is cosmetic only.
BOX_W=68
_rule() { local c="$1" n=$BOX_W out=''; while [ $n -gt 0 ]; do out="$out$c"; n=$((n-1)); done; printf '%s' "$out"; }
box_top() { printf '╔%s╗\n' "$(_rule ═)"; }
box_sep() { printf '╠%s╣\n' "$(_rule ═)"; }
box_bot() { printf '╚%s╝\n' "$(_rule ═)"; }
box_row() {
    local s="${1:-}" adj="${2:-0}" pad
    pad=$(( BOX_W - ${#s} - 2 - adj ))
    [ "$pad" -lt 0 ] && pad=0
    printf '║ %s%*s ║\n' "$s" "$pad" ''
}

# --- Squash guard for PR-only branches ----------------------------------------
# `git merge --squash --ff feature` on main stages the result and writes
# SQUASH_MSG but creates no merge commit, so pre-merge-commit never fires and the
# following `git commit` would land the whole feature on a PR-only branch as one
# ordinary commit. That commit is the one to refuse.
if [[ "$CURRENT_BRANCH" =~ $PR_ONLY_RE && -f "$GIT_DIR/SQUASH_MSG" ]]; then
    echo ""
    box_top
    box_row "⛔  $CURRENT_BRANCH IS PR-ONLY — SQUASH MERGE BLOCKED" 1
    box_sep
    box_row ""
    box_row "A squash merge is still a local merge into $CURRENT_BRANCH."
    box_row "It moves only through a reviewed pull request."
    box_row ""
    box_row "Undo:   git reset --merge   (drops the squashed changes)"
    box_row "Then open a PR from the feature branch instead."
    box_row ""
    box_bot
    echo ""
    exit 1
fi

# --- Note gate for note-gated branches ----------------------------------------
[[ "$CURRENT_BRANCH" =~ $PROTECTED_RE ]] || exit 0

# MERGE_HEAD present ⇒ a merge is in progress. Absent ⇒ ordinary commit, nothing to
# gate.
MERGE_HEAD_FILE="$GIT_DIR/MERGE_HEAD"
[ -f "$MERGE_HEAD_FILE" ] || exit 0

MERGE_SHA=$(cat "$MERGE_HEAD_FILE")

# A back-merge — the incoming commit is the tip of a PR-only branch (default main)
# — needs no note. Everything on that branch arrived through a reviewed pull
# request, and reconciling it into the integration branch is routine maintenance,
# not a feature landing (post-merge makes the same distinction). Without this,
# `git merge main` on dev was blocked for want of a note nobody could stamp.
#
# Only `refs/heads/<x>` and `refs/remotes/origin/<x>` count — a stale
# `upstream/main` or a fork's remote is not evidence of review. And because a local
# branch can be pointed anywhere (`git branch -f main feature/x`), when origin has
# the branch the commit must actually be on it. PR_ONLY_BRANCHES is read from HEAD
# like everything else here, so the incoming branch cannot declare itself PR-only.
while read -r ref sha; do
    case "$ref" in
        refs/heads/*)          short="${ref#refs/heads/}" ;;
        refs/remotes/origin/*) short="${ref#refs/remotes/origin/}" ;;
        *)                     continue ;;
    esac
    [[ "$sha" == "$MERGE_SHA" && "$short" =~ $PR_ONLY_RE ]] || continue
    if origin_sha=$(git rev-parse -q --verify "refs/remotes/origin/$short" 2>/dev/null); then
        git merge-base --is-ancestor "$MERGE_SHA" "$origin_sha" 2>/dev/null || continue
    fi
    echo "✅ Back-merge of PR-only branch $short into $CURRENT_BRANCH — already reviewed, no note needed"
    exit 0
done < <(git for-each-ref --format='%(refname) %(objectname)' refs/heads refs/remotes/origin)

MERGE_BRANCH=$(git name-rev --name-only "$MERGE_SHA" 2>/dev/null || echo "$MERGE_SHA")

NOTE=$(git notes --ref=pre-merge-check show "$MERGE_SHA" 2>/dev/null || true)

if echo "$NOTE" | grep -q "^passed:"; then
    echo "✅ Pre-merge check verified for $MERGE_BRANCH → $CURRENT_BRANCH"
    exit 0
fi

echo ""
box_top
box_row "❌  PRE-MERGE CHECK REQUIRED" 1
box_sep
box_row ""
box_row "Merging: $MERGE_BRANCH"
box_row "Into:    $CURRENT_BRANCH"
box_row ""
box_row "Run /pre-merge-check in the feature worktree first. When"
box_row "every check passes it stamps a note on the commit, and"
box_row "this hook lets the merge through."
box_row ""
box_row "Undo this half-finished merge:   git merge --abort"
box_row "Bypass (emergencies only):       git merge --no-verify"
box_row ""
box_bot
echo ""
exit 1
