#!/usr/bin/env bash
# pre-merge-commit hook — the merge gate. Two mechanisms:
#
#  1. PR-ONLY branches (default: main). Blocked from ANY local merge — they move
#     only through a reviewed pull request. pre-merge-commit fires only when git
#     is about to create a merge commit; a fast-forward (e.g. `git pull --ff-only`)
#     does NOT fire it. So the hook firing on a PR-only branch IS the violation.
#     This needs no MERGE_HEAD and is robust. Sync the branch locally with:
#         git checkout <branch> && git pull --ff-only origin <branch>
#
#  2. NOTE-GATED branches (e.g. dev/staging) — moved to the **commit-msg** hook.
#     It used to live here and was a silent no-op: modern git (verified on 2.55)
#     writes MERGE_HEAD *after* pre-merge-commit runs, so the lookup never found
#     the incoming commit and note-gated branches were never actually enforced.
#     commit-msg runs with MERGE_HEAD present, so the check works there.
#     See hooks/git/commit-msg — install BOTH or the gate is only half built.
#
# Configuration — same contract as hooks/agent/pre-commit-check.sh. First match wins:
#   1. Environment            FLIGHT_RULES_PR_ONLY_BRANCHES='^main$'
#   2. <repo>/.ai/flight-rules.conf    PR_ONLY_BRANCHES=^main$
#   3. The default below
# Parsed as data, never sourced. Commit this file (e.g. into .ai/hooks/) and run
# install.sh once per clone.
#
# Bypass (breaks the rules — emergencies only):  git merge --no-verify

set -euo pipefail

DEFAULT_PR_ONLY='^main$'

read_conf() {
  local key="$1" file="$2"
  # return 0, not 1: these hooks run under `set -e`, so a missing conf file must
  # yield empty output rather than a failure status — otherwise the hook aborts
  # and blocks every commit in a repo that has no conf file.
  [ -r "$file" ] || return 0
  sed -n -E "s/^[[:space:]]*${key}[[:space:]]*=[[:space:]]*(.*)$/\1/p" "$file" \
    | sed -E 's/[[:space:]]+$//; s/^"(.*)"$/\1/; s/^'\''(.*)'\''$/\1/' \
    | tail -1
}

REPO_ROOT=$(git rev-parse --show-toplevel 2>/dev/null || echo ".")
CONF_FILE="$REPO_ROOT/.ai/flight-rules.conf"

PR_ONLY_RE="${FLIGHT_RULES_PR_ONLY_BRANCHES:-$(read_conf PR_ONLY_BRANCHES "$CONF_FILE")}"
PR_ONLY_RE="${PR_ONLY_RE:-$DEFAULT_PR_ONLY}"

CURRENT_BRANCH=$(git branch --show-current)

# --- Mechanism 1: PR-only branches — block any local merge commit -------------
if [[ "$CURRENT_BRANCH" =~ $PR_ONLY_RE ]]; then
    echo ""
    echo "⛔  $CURRENT_BRANCH IS PR-ONLY — local merge blocked"
    echo ""
    echo "    $CURRENT_BRANCH is updated only through a reviewed pull request, never a"
    echo "    local git merge. Do this instead:"
    echo "      1. gh pr create --base $CURRENT_BRANCH   (open a PR)"
    echo "      2. let CI run, review, then Merge on the host"
    echo "      3. git checkout $CURRENT_BRANCH && git pull --ff-only origin $CURRENT_BRANCH"
    echo ""
    echo "    Undo this half-finished merge:   git merge --abort"
    echo "    Emergency bypass (discouraged):  git merge --no-verify"
    echo ""
    exit 1
fi

# Mechanism 2 (the note gate) lives in the commit-msg hook — see hooks/git/commit-msg.
exit 0
