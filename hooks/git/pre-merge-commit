#!/usr/bin/env bash
# pre-merge-commit hook — the merge gate. Two mechanisms:
#
#  1. PR-ONLY branches (default: main). Blocked from ANY local merge — they move
#     only through a reviewed pull request. pre-merge-commit fires only when git
#     is about to create a merge commit; a fast-forward (e.g. `git pull --ff-only`)
#     does NOT fire it. So the hook firing on a PR-only branch IS the violation.
#     This needs no MERGE_HEAD. It is NOT the whole guarantee: a conflicted merge
#     stops before the merge commit and never reaches this hook, so the finishing
#     `git commit` arrives here as an ordinary commit. reference-transaction is the
#     backstop that closes it; this hook stays for the early, specific message.
#     Sync the branch locally with:
#         git checkout <branch> && git pull --ff-only origin <branch>
#
#  2. NOTE-GATED branches (e.g. dev/staging) — moved to the **commit-msg** hook.
#     It used to live here and was a silent no-op: modern git (verified on 2.55)
#     writes MERGE_HEAD *after* pre-merge-commit runs, so the lookup never found
#     the incoming commit and note-gated branches were never actually enforced.
#     commit-msg runs with MERGE_HEAD present, so the check works there.
#     See the commit-msg hook alongside this one — install BOTH or the gate is only
#     half built.
#
# Configuration — first match wins:
#   1. Environment            FLIGHT_RULES_PR_ONLY_BRANCHES='^main$'
#   2. .ai/flight-rules.conf **as committed on the merge target** (see below)
#   3. The default below
# Parsed as data, never sourced. Commit this file (e.g. into .ai/hooks/) and run
# install.sh once per clone.
#
# ⚠️ The conf is read from `HEAD:.ai/flight-rules.conf` — the merge TARGET's committed
#    state — NOT from the working tree. By the time this hook runs git has already
#    updated the working tree with the merge result, so a working-tree read would let
#    the incoming branch relax the very rule that judges it: a branch shipping
#    `PR_ONLY_BRANCHES=^nothing$` could merge itself straight into main. Falling back
#    to the default (not the working tree) when HEAD has no conf keeps that closed.
#    See the longer note in the commit-msg hook alongside this one.
#
# Bypass (breaks the rules — emergencies only):  git merge --no-verify

set -euo pipefail

DEFAULT_PR_ONLY='^main$'
CONF_PATH='.ai/flight-rules.conf'   # repo-relative

read_conf_at_head() {
  local key="$1" path="$2" content
  # return 0, not 1, on a missing file: these hooks run under `set -e`, so a failure
  # status here would abort the hook and block every commit in a repo with no conf.
  content=$(git show "HEAD:$path" 2>/dev/null) || return 0
  printf '%s\n' "$content" \
    | sed -n -E "s/^[[:space:]]*${key}[[:space:]]*=[[:space:]]*(.*)$/\1/p" \
    | sed -E 's/[[:space:]]+$//; s/^"(.*)"$/\1/; s/^'\''(.*)'\''$/\1/' \
    | tail -1
}

PR_ONLY_RE="${FLIGHT_RULES_PR_ONLY_BRANCHES:-$(read_conf_at_head PR_ONLY_BRANCHES "$CONF_PATH")}"
PR_ONLY_RE="${PR_ONLY_RE:-$DEFAULT_PR_ONLY}"

CURRENT_BRANCH=$(git branch --show-current)

# --- Box drawing --------------------------------------------------------------
# A blocked merge scrolls past in a wall of terminal output; the box makes it
# impossible to miss. Duplicated verbatim in commit-msg: git hooks are copied
# into projects individually and must stay self-contained, so a shared library
# would be one more file to keep in sync for eight lines of formatting.
#
# `adj` is the number of EXTRA display columns the row's content occupies beyond
# its character count — bash's ${#s} counts characters, and an emoji is one
# character but two columns, so a row containing one emoji passes adj=1. Getting
# this wrong shifts that row's right border by a column; it is cosmetic only.
BOX_W=68
_rule() { local c="$1" n=$BOX_W out=''; while [ $n -gt 0 ]; do out="$out$c"; n=$((n-1)); done; printf '%s' "$out"; }
box_top() { printf '╔%s╗\n' "$(_rule ═)"; }
box_sep() { printf '╠%s╣\n' "$(_rule ═)"; }
box_bot() { printf '╚%s╝\n' "$(_rule ═)"; }
box_row() {
    local s="${1:-}" adj="${2:-0}" pad
    pad=$(( BOX_W - ${#s} - 2 - adj ))
    [ "$pad" -lt 0 ] && pad=0
    printf '║ %s%*s ║\n' "$s" "$pad" ''
}

# A refusal a broken pattern decided: the pattern named, where it is set, and the
# command that gets past the gate it broke from where this refusal leaves you — the
# refused command again, not `git merge`, which an unfinished merge refuses (#103
# review; #100 was the same mistake). <key> <value> <what> <command to run again>
broken_box() {
    echo ""
    box_top
    box_row "⛔  $1 DOES NOT COMPILE — $3 BLOCKED" 1
    box_sep
    box_row ""
    box_row "$1 is not a pattern that compiles:"
    box_row "  $2"
    box_row "so every branch is taken as matching it until it is fixed."
    box_row ""
    box_row "The project owner fixes it in .ai/flight-rules.conf, on a"
    box_row "branch, or in FLIGHT_RULES_$1. Until that fix"
    box_row "has landed, give the pattern meant in front of each command"
    box_row "it refuses. This one:"
    box_row "  FLIGHT_RULES_$1='<pattern>' $4"
    box_row "keeping any other FLIGHT_RULES_ setting it carried. A"
    box_row "branch the pattern means still moves only by pull request."
    box_row ""
    box_bot
    echo ""
}

# --- Mechanism 1: PR-only branches — block any local merge commit -------------
# `off` names no branch. Read as a pattern it matched any branch with "off" in its name
# (#103 review, 2026-10-22). A pattern that does not compile matches every branch, not
# none: [[ =~ ]] returns 2 for it, which read as "no match" and let every merge through
# (#103). Case-insensitively, as the agent guard matches: `^MAIN$` let a local merge
# into main through (#103 review).
[ "$PR_ONLY_RE" = "off" ] && exit 0
shopt -s nocasematch
_rc=0; [[ "$CURRENT_BRANCH" =~ $PR_ONLY_RE ]] || _rc=$?
shopt -u nocasematch
if [ "$_rc" -eq 2 ]; then
    # This refusal leaves the merge in progress, so the merge is finished by a commit.
    broken_box PR_ONLY_BRANCHES "$PR_ONLY_RE" "LOCAL MERGE" "git commit --no-edit"
    echo "Undo this half-finished merge:   git merge --abort"
    exit 1
fi
if [ "$_rc" -eq 0 ]; then
    echo ""
    box_top
    box_row "⛔  $CURRENT_BRANCH IS PR-ONLY — LOCAL MERGE BLOCKED" 1
    box_sep
    box_row ""
    box_row "$CURRENT_BRANCH is updated only through a reviewed pull"
    box_row "request, never a local git merge. Do this instead:"
    box_row ""
    box_row "  1. gh pr create --base $CURRENT_BRANCH"
    box_row "  2. let CI run, review, then Merge on the host"
    box_row "  3. git checkout $CURRENT_BRANCH"
    box_row "     git pull --ff-only origin $CURRENT_BRANCH"
    box_row ""
    box_row "Undo this half-finished merge:   git merge --abort"
    box_row "Emergency bypass (discouraged):  git merge --no-verify"
    box_row ""
    box_bot
    echo ""
    exit 1
fi

# Mechanism 2 (the note gate) lives in the commit-msg hook alongside this one.
exit 0
