#!/usr/bin/env bash
# reference-transaction hook — the ref gate for PR-only branches.
#
# ONE RULE:  a PR-only branch may only move to a commit that is already on its
# upstream (refs/remotes/origin/<branch>). Any other protected branch moving off its
# upstream to a commit that is not a merge made on it, not a value it has held, and not
# on a PR-only branch's upstream is warned of, never refused (warn_direct).
#
# Why this hook and not another. Every other guard in this repo asks "what command
# is this?" and then has to enumerate the commands that write to a branch. That set
# is open-ended and the enumeration kept losing:
#
#   - `git cherry-pick` and `git revert` run NEITHER pre-commit NOR commit-msg
#     (verified 2026-09-10, git 2.55: they are sequencer operations and fire only
#     prepare-commit-msg), so a pre-commit check does not see them at all.
#   - `git branch -f` and `git update-ref` create no commit, so no commit hook fires.
#   - A CONFLICTED `git merge` never reaches pre-merge-commit: git stops at the
#     conflict, and the finishing `git commit` is an ordinary commit.
#
# reference-transaction fires for all of them, because all of them end in a ref
# moving. It asks where the ref LANDED, not what put it there — so a git subcommand
# nobody thought of cannot walk around it.
#
# What stays allowed: `git pull --ff-only origin main` and any other move onto a
# commit already reviewed on the remote; every operation on a non-PR-only branch, a
# direct change to a protected one said as it goes ahead;
# fetch, status, log, worktree add, and all feature work.
#
# Configuration — first match wins:
#   1. Environment            FLIGHT_RULES_PR_ONLY_BRANCHES='^main$'
#   2. .flight-rules/conf **as committed on the upstream**, then on HEAD
#   3. The default below
# Parsed as data, never sourced.
#
# ⚠️ The conf is read from the upstream's committed state first, not the working
#    tree. The agent guard deliberately reads the working tree (it must react to a
#    conf the owner just edited), which means editing the conf is a way past IT.
#    This hook is the backstop for that: a working-tree edit — or a branch that
#    ships `PR_ONLY_BRANCHES=^nothing$` and then merges itself — does not change
#    what the reviewed upstream says.
#
# Bypass: none. `--no-verify` does not apply to reference-transaction, which is the
# point. To move a PR-only branch to something not on the remote, the owner turns
# the policy off in the conf AND pushes that change through review.

set -uo pipefail

DEFAULT_PR_ONLY='^main$'
DEFAULT_PROTECTED='^(main|master|dev|develop|development|staging|stage|qa|uat|prod|production)$|^release(/|$)'
CONF_PATH='.flight-rules/conf'
ZERO='0000000000000000000000000000000000000000'

# Only the "prepared" phase can still refuse the transaction. "committed" and
# "aborted" are notifications; exiting non-zero there does nothing but noise.
[ "${1:-}" = "prepared" ] || exit 0

read_conf_from() {   # <committish> <key>
    local ref="$1" key="$2" content
    content=$(git show "${ref}:${CONF_PATH}" 2>/dev/null) || return 0
    printf '%s\n' "$content" \
        | sed -n -E "s/^[[:space:]]*${key}[[:space:]]*=[[:space:]]*(.*)$/\1/p" \
        | sed -E 's/[[:space:]]+#.*$//; s/[[:space:]]+$//; s/^"(.*)"$/\1/; s/^'\''(.*)'\''$/\1/' \
        | tail -1
}

# shq <s>: <s> quoted for a shell to paste — install.sh's, verbatim, and the reasons
# are there (install.test.sh compares). A worktree directory holding a space printed
# a route that split when pasted (fix review, 2026-10-26).
shq() {
  local q="'\\''"
  case "$1" in
    ''|=*|'~'*|*[!ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789._/@+,:-]*) printf "'%s'" "${1//\'/$q}" ;;
    *) printf '%s' "$1" ;;
  esac
}

BOX_W=68
_rule() { local c="$1" n=$BOX_W out=''; while [ $n -gt 0 ]; do out="$out$c"; n=$((n-1)); done; printf '%s' "$out"; }
box_top() { printf '╔%s╗\n' "$(_rule ═)"; }
box_sep() { printf '╠%s╣\n' "$(_rule ═)"; }
box_bot() { printf '╚%s╝\n' "$(_rule ═)"; }
box_row() {
    local s="${1:-}" adj="${2:-0}" pad
    pad=$(( BOX_W - ${#s} - 2 - adj ))
    # A row too long for the box (a long path) runs on past it, unframed, rather than
    # pushing out its right edge (0.29.0 release-fix review, Z-4).
    if [ "$pad" -lt 0 ]; then printf '║ %s\n' "$s"; else printf '║ %s%*s ║\n' "$s" "$pad" ''; fi
}

# A refusal a broken pattern decided: the pattern named, where it is set, and the
# command that gets past the gate it broke from where this refusal leaves you — the one
# that finishes or repeats what was refused, never a second `git merge`, which an
# unfinished merge refuses (#103 review; #100 was the same mistake). The route is for a
# branch the pattern does not mean; on one it does, the pattern meant refuses as well.
# <key> <value> <what> <branch> <command>
broken_box() {
    echo ""
    box_top
    box_row "⛔  $1 DOES NOT COMPILE — $3 BLOCKED" 1
    box_sep
    box_row ""
    box_row "$1 is not a pattern that compiles:"
    box_row "  $2"
    box_row "so every branch is taken as matching it until it is fixed."
    box_row ""
    box_row "The project owner fixes it in .flight-rules/conf, on a"
    box_row "branch, or in FLIGHT_RULES_$1. Until that fix"
    box_row "has landed, and if $4 is not a branch it means,"
    box_row "give the pattern meant in front of this command:"
    box_row "  FLIGHT_RULES_$1='<pattern>' \\"
    box_row "    $5"
    box_row "keeping any other FLIGHT_RULES_ setting it carried."
    box_row ""
    box_bot
    echo ""
}

# warn_direct: a protected branch that is not PR-only (dev) moving to a commit that is
# not on its upstream, not a merge made on it, not a value it has held, and not on a
# PR-only branch's upstream — a commit made on it, an amend, a
# cherry-pick, a revert, a reset, a fast-forward onto it — is said, never refused
# (#115). A plain commit on dev passed every git hook: a probe script that lost its cd
# committed on local dev, inside a script the agent guard never read (2026-10-25).
# Anyone who means to change dev directly can (owner, 2026-11-09). Here, not in
# commit-msg: a clean cherry-pick or revert runs no commit hook. A branch with no
# upstream is left alone, as the rule below leaves it: there, a fresh repository's own
# commits would be all it said.
warn_direct() {
    local m=0 cur up b
    printf '%s' "$short" | grep -qiE -e "${PROT_RE:-$DEFAULT_PROTECTED}" 2>/dev/null || m=$?
    [ "$m" -eq 1 ] && return 0
    cur=$(git rev-parse -q --verify "$ref" 2>/dev/null) || return 0
    # A no-op update would pass the reflog test below too; this only saves the git calls.
    [ "$new" != "$cur" ] && [ "$new" != "$ZERO" ] || return 0
    git rev-parse -q --verify "$upstream" >/dev/null 2>&1 || return 0
    git merge-base --is-ancestor "$new" "$upstream" 2>/dev/null && return 0
    # Where this transaction moves the upstream too: `git fetch origin dev:dev` updates
    # both at once, and read before it lands, origin/dev lacked what it brought.
    up=$(printf '%s\n' "$TX" | awk -v r="$upstream" '$3 == r { n = $2 } END { print n }')
    [ -n "$up" ] && git merge-base --is-ancestor "$new" "$up" 2>/dev/null && return 0
    # A merge made on the branch itself: its first parent is where the branch is now.
    # Any merge was waved through, so an amend of dev's merge tip, or a fast-forward
    # onto a feature tip that had dev merged in, said nothing (#144 review, E-1).
    git rev-parse -q --verify "$new^2" >/dev/null 2>&1 \
        && [ "$(git rev-parse -q --verify "$new^1" 2>/dev/null)" = "$cur" ] && return 0
    # A value the branch has held, by its own reflog: an undo (reset --hard HEAD^ off the
    # later of two local merges), a redo (ORIG_HEAD, @{1}), a branch -f back. It was
    # judged when it first landed. A first-parent test caught the undo and missed the
    # redo (#144 fix reviews, F-1, H-1). The branch's reflog, not HEAD's: HEAD has held
    # every feature tip checked out. An amended merge has not been held, so it is said.
    # A case, not a pipe into grep -q, which under pipefail could take a SIGPIPE for no
    # match.
    case $'\n'"$(git log -g --format=%H "$ref" 2>/dev/null)"$'\n' in
        *$'\n'"$new"$'\n'*) return 0 ;;
    esac
    # On a PR-only branch's upstream (origin/main) it was reviewed there: a fast-forward
    # of dev to a release merge on main warned once a merge had to be made on dev (#144
    # fix review, F-2). The conf is trusted to name only reviewed branches. One grep over
    # the list, not one per ref: with 2,000 origin refs that cost 3.9s a move (H-2). A
    # ref name holds no space or glob character.
    if [ "$PR_ONLY_RE" != off ]; then
        for b in $(git for-each-ref --format='%(refname:lstrip=3)' refs/remotes/origin/ \
                   | grep -iE -e "$PR_ONLY_RE" 2>/dev/null); do
            git merge-base --is-ancestor "$new" "refs/remotes/origin/$b" 2>/dev/null && return 0
        done
    fi
    {
        echo "⚠️  flight-rules: $short moves to $(git log -1 --format='%h (%s)' "$new"), which no merge brought in and origin/$short does not have."
        echo "   $short is a protected branch: work reaches it by merging its own branch. The move goes ahead; nothing leaves this clone until $short is pushed."
        [ "$m" -eq 0 ] || echo "   PROTECTED_BRANCHES (${PROT_RE:-$DEFAULT_PROTECTED}) is not a pattern that compiles, so every branch is taken as protected until it is fixed."
    } >&2
}

# The whole transaction, read once: warn_direct looks in it for the upstream's update.
TX=$(cat)
while read -r _old new ref; do
    case "$ref" in
        refs/heads/*) short="${ref#refs/heads/}" ;;
        *) continue ;;                      # remote-tracking refs, tags, HEAD, AUTO_MERGE
    esac

    upstream="refs/remotes/origin/$short"

    # Config comes from the reviewed upstream where there is one; HEAD otherwise.
    PR_ONLY_RE="${FLIGHT_RULES_PR_ONLY_BRANCHES:-}"
    if [ -z "$PR_ONLY_RE" ]; then
        PR_ONLY_RE=$(read_conf_from "$upstream" PR_ONLY_BRANCHES)
        [ -z "$PR_ONLY_RE" ] && PR_ONLY_RE=$(read_conf_from HEAD PR_ONLY_BRANCHES)
        PR_ONLY_RE="${PR_ONLY_RE:-$DEFAULT_PR_ONLY}"
    fi
    # `none` is `off`, as the doctor reads it (0.28.0 release review).
    [ "$PR_ONLY_RE" = none ] && PR_ONLY_RE=off

    # PROTECTED_BRANCHES=off is the opt-out the README, the agent guard's own block
    # message and flight-rules-doctor.sh all name. It used to disable only the agent guard, so a
    # project that took the documented opt-out still had git refusing every move here,
    # citing PR_ONLY_BRANCHES — a key its owner never set. PR-only is a subset of
    # protected: if nothing is protected, nothing is PR-only.
    PROT_RE="${FLIGHT_RULES_PROTECTED_BRANCHES:-}"
    if [ -z "$PROT_RE" ]; then
        PROT_RE=$(read_conf_from "$upstream" PROTECTED_BRANCHES)
        [ -z "$PROT_RE" ] && PROT_RE=$(read_conf_from HEAD PROTECTED_BRANCHES)
    fi
    # `none` is `off`, as the agent guard, session-start, post-merge and the doctor read
    # it (0.28.0 release review).
    [ "$PROT_RE" = none ] && PROT_RE=off
    [ "$PROT_RE" = "off" ] && continue

    # A pattern that does not compile matches every branch, not none: grep exits 2
    # for it, which read as "no match" and let the move through (#103). -i, as the
    # agent guard matches; -e, or a pattern starting with `-` is read as an option
    # (#103 review).
    _rc=1; [ "$PR_ONLY_RE" = off ] || { _rc=0; printf '%s' "$short" | grep -qiE -e "$PR_ONLY_RE" 2>/dev/null || _rc=$?; }
    [ "$_rc" -eq 1 ] && { warn_direct; continue; }

    # A ref that does not exist yet is being CREATED (clone, `git branch <new>`),
    # not moved. `_old` cannot be used to detect this: `git update-ref <ref> <sha>`
    # with no old value reports all-zeros for a ref that plainly exists, which would
    # turn the creation exemption into a bypass for the exact command it must catch.
    cur=$(git rev-parse -q --verify "$ref" 2>/dev/null) || continue

    # An update to the value the ref already has moves nothing: `merge --abort`,
    # `reset --merge` and `reset --hard HEAD` write one. Refused as a move, they left a
    # branch ahead of its upstream with no undo (#103 review). Compared against the
    # ref's current value, for the reason above: `_old` can read as all-zeros.
    [ "$new" = "$cur" ] && continue

    # Deleting a local branch is not moving it onto unreviewed work. `git push
    # --delete` (the destructive one) is the agent guard's job and does not reach here.
    [ "$new" = "$ZERO" ] && continue

    # No upstream to compare against — a repo with no remote, or one not fetched
    # yet. There is no reviewed state to enforce, so stay out of the way rather
    # than making a fresh `git init` repo unusable on its own default branch.
    git rev-parse -q --verify "$upstream" >/dev/null 2>&1 || continue

    # THE RULE.
    git merge-base --is-ancestor "$new" "$upstream" 2>/dev/null && continue

    if [ "$_rc" -ne 0 ]; then
        {
            broken_box PR_ONLY_BRANCHES "$PR_ONLY_RE" "REF MOVE" "$short" "<the same command>"
            echo "Refused: this would move $short to a commit not on origin/$short."
            # A refused cherry-pick, revert or am stays in progress, and running it again
            # fails there; its --continue is what finishes it (#103 review).
            echo "A cherry-pick, revert or am it stopped is still in progress: give the"
            echo "pattern to its --continue (git cherry-pick --continue, …) instead."
            # A refused merge too: a second `git merge` fails with "You have not
            # concluded your merge" (0.27.0 release review, as #100 found in commit-msg).
            echo "So is a merge it stopped: give the pattern to git commit --no-edit."
        } >&2
        exit 1
    fi
    {
        echo ""
        box_top
        box_row "❌  PROTECTED BRANCH — $short" 1
        box_sep
        box_row ""
        box_row "This would move \"$short\" to a commit that is not on"
        box_row "origin/$short. That branch moves only through a"
        box_row "reviewed pull request."
        box_row ""
        box_row "Whatever the command was — commit, merge, cherry-pick,"
        box_row "revert, rebase, branch -f, update-ref, reset --hard —"
        box_row "the ref landing off-upstream is the violation."
        box_row ""
        # From the local integration branch, the authoritative base every new branch is cut
        # from, a revert aside, with origin's commits it lacks brought in, the rows one
        # chain from the `cd` to the add (U-1, T-1), into the project's worktree directory, as
        # the guard, /feature-start and Required 8 say it (rules/git-worktree-workflow.md →
        # *Which branch new work starts from*): with no start point the branch was cut from
        # HEAD, the PR-only branch itself (full release review, S3); from origin's, it
        # missed merges not yet pushed (0.29.0 release review, R-1). The layouts are the
        # guard's `worktree_route`'s, and its comment says what each once got wrong, and
        # why no command row carries a `#` or an apostrophe (V-1).
        _wt="${FLIGHT_RULES_WORKTREE_DIR:-$(read_conf_from HEAD WORKTREE_DIR)}"; _wt="${_wt:-.flight-rules/worktrees}"
        _int=$(read_conf_from HEAD INTEGRATION_BRANCH); _int="${_int:-main}"
        _root="" _holder="" _cur="" _stale="" _gone=""
        while IFS= read -r _l; do
            case "$_l" in
                "worktree "*) _cur="${_l#worktree }"; [ -n "$_root" ] || _root="$_cur" ;;
                "branch refs/heads/$_int") _holder="$_cur" ;;
                prunable*) [ "$_cur" = "$_holder" ] && _stale=1 ;;
            esac
        done < <(git worktree list --porcelain 2>/dev/null)
        # git's own mark first; the .git file for a git too old to print it (C-3).
        [ -n "$_holder" ] && { [ -n "$_stale" ] || [ ! -e "$_holder/.git" ]; } && { _gone="$_holder"; _holder=""; }
        _qi=$(shq "$_int")
        # A failed pull is left for the person: a merge in progress in that checkout may
        # be theirs, so the prose says to abort nothing. The guard's `worktree_route`
        # comment says why (S-1, Q-1, P-1, O-1).
        if [ -n "$_holder" ]; then
            box_row "$_int is checked out, so the pull runs in that checkout."
            box_row "It brings in the commits origin/$_int has that it lacks,"
            box_row "if any, merging them if the two diverged. If it fails, stop"
            box_row "and ask, and leave whatever it left there to the person."
            box_row ""
        elif git show-ref --verify --quiet "refs/heads/$_int"; then
            # Gone, not pruned: moved and deleted look the same to git, and a prune
            # clears every worktree it cannot find, past repair (B-1). After a repair,
            # the pull named, not "run it again", which a refused merge blocks (C-1);
            # the folder still there, repair restores it (C-2).
            _qg=$(shq "$_gone")
            if [ -d "$_gone" ]; then
                box_row "$_int was checked out at"
                box_row "  $_qg,"
                box_row "whose .git file is missing or broken, so stop and ask."
                box_row "This restores it, staged work included, though git"
                box_row "prints an error as it does:"
                box_row "  git worktree repair $_qg"
                box_row "Then pull in it, and run the add below:"
                box_row "  git -C $_qg pull --ff --no-rebase origin $_qi"
                box_row ""
            elif [ -n "$_gone" ]; then
                box_row "$_int was checked out at"
                box_row "  $_qg,"
                box_row "which is gone: moved, on a disk not mounted, or deleted,"
                box_row "which git cannot tell apart, so stop and ask. If it was"
                box_row "moved, repair it, then pull in it, and run the add below:"
                box_row "  git worktree repair <new path>"
                box_row "  git -C <new path> pull --ff --no-rebase origin $_qi"
                box_row "If it was deleted, prune, which clears every worktree git"
                box_row "cannot find, then run the commands below:"
                box_row "  git worktree prune"
                box_row ""
            fi
            box_row "$_int is checked out in no live worktree."
            box_row "The commands below bring in the commits origin/$_int"
            box_row "has that it lacks, if any. If git refuses, read its"
            box_row "message (diverged, never pushed, or unreachable), and"
            box_row "stop and ask."
            box_row ""
        fi
        box_row "Do this instead:"
        box_row "  cd $(shq "${_root:-.}") && \\"
        if [ -n "$_holder" ] && [ "$_holder" = "$_root" ]; then
            box_row "    git pull --ff --no-rebase origin $_qi && \\"
        elif [ -n "$_holder" ]; then
            box_row "    git -C $(shq "$_holder") \\"
            box_row "        pull --ff --no-rebase origin $_qi && \\"
        elif ! git show-ref --verify --quiet "refs/heads/$_int"; then
            box_row "    git fetch origin && \\"
            box_row "    git branch --track $_qi origin/$_qi && \\"
        else
            box_row "    git fetch origin && \\"
            box_row "    { git merge-base --is-ancestor origin/$_qi $_qi ||"
            box_row "        git fetch origin $_qi:$_qi; } && \\"
        fi
        # Two rows for the add: on one, the default route was 70 columns in a 66-column box.
        box_row "    git worktree add $(shq "${_wt%/}")/<name> \\"
        box_row "        -b <prefix>/<name> $_qi"
        box_row "  # commit there, push, open a PR"
        box_row ""
        box_row "To sync this branch:"
        box_row "  git pull --ff-only origin $short"
        box_row ""
        box_row "If this project does not gate $short, its owner changes"
        box_row "PR_ONLY_BRANCHES in .flight-rules/conf and pushes"
        box_row "that through review. Editing your working tree copy"
        box_row "will not lift this: the rule is read from the remote."
        box_row ""
        box_bot
        echo ""
    } >&2
    exit 1
done <<<"$TX"

exit 0
